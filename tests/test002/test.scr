set height 0
set width 0

define stutter_step
    set variable $_exitcode=$void
    while $_isvoid ($_exitcode)
        p *
        p ?
        step
        end
    end

file test

### Make sure we have a known 'p ?' range
echo KNOWN GOOD LINES: 2\n
p/r 6

### Make sure 'p *' is clean at the beginning
echo KNOWN GOOD LINES: 1\n
p *

### Just run the whole program clean, to establish a baseline
### (We don't want to think we have a debugging problem when
###  in fact it was the test program that changed.)
echo KNOWN GOOD START\n
r
echo KNOWN GOOD FINISH\n

### Make sure 'p *' is clean at the end
echo KNOWN GOOD LINES: 1\n
p *

### In general, what preceded this line is boilerplate. This
### first breakpoint will need to be different for each test.cbl program
b 126
echo KNOWN GOOD START\n
r
stutter_step
echo KNOWN GOOD FINISH\n

## And having stepped through the program line-by-line, we are done
q