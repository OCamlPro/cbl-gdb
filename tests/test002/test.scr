set height 0
set width 0

define stutter_step
    set variable $_exitcode=1031
    while $_exitcode==1031
        echo 
        cprint *
        cprint ?
        cprint/x 1
        step
        end
    end

define printem
    echo KNOWN GOOD START\n
    echo cprint/v0 *\n
    cprint/v0 *
    echo cprint/v0 ?\n
    cprint/v0 ?
    echo cprint/v3 *\n
    cprint/v3 *
    echo cprint/v3 ?\n
    cprint/v3 ?
    echo cprint/x 1\n
    cprint/x 1
    echo cprint/m *\n
    cprint/m *
    echo cprint/m ?\n
    cprint/m ?
	echo cprint/x 1\n
	cprint/x 1
	echo cprint/b 1\n
	cprint/b 1
    echo KNOWN GOOD FINISH\n
    end

define printloop
    set variable $_exitcode=1031
    while $_exitcode==1031
       printem
       continue
       end
    end

