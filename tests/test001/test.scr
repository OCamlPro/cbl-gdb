set height 0
set width 0

define stutter_step
    set variable $_exitcode=1031
    while $_exitcode==1031
        echo
        cprint *
        cprint ?
        cprint/x 1
        step
        end
    end

define stutter
    echo
    cprint *
    cprint ?
    cprint/x 1
    step
    end

file test

### Make sure we have a known 'cprint ?' range
echo KNOWN GOOD LINES: 2\n
cprint/r 6

### Make sure 'cprint *' is clean at the beginning
echo KNOWN GOOD LINES: 1\n
cprint *

### Just run the whole program clean, to establish a baseline
### (We don't want to think we have a debugging problem when
###  in fact it was the test program that changed.)
echo KNOWN GOOD START\n
r
echo KNOWN GOOD FINISH\n

### Make sure 'cprint *' is clean at the end
echo KNOWN GOOD LINES: 1\n
cprint *

### Run the whole program after a known good starting breakpoint
cstart
echo KNOWN GOOD START\n
stutter_step
echo KNOWN GOOD FINISH\n

### Let's try some assignments
cstart
echo KNOWN GOOD START\n
stutter
stutter
stutter
stutter
cp ws-firstname of ws-bob = "bobby"
cp WS-FIRSTNAME in WS-JIM=WS-LASTNAME of WS-JIM
stutter
stutter
stutter
echo KNOWN GOOD FINISH\n
continue

## And having stepped through the program line-by-line, we are done
q