#!/usr/bin/python3

import sys
import re
import os

def main() :
    if len(sys.argv) > 1 :
        KNOWN_GOOD_PREFIX="KNOWN GOOD "
        LEN_KNOWN_GOOD_PREFIX = len(KNOWN_GOOD_PREFIX)
        LINES="LINES: "
        LEN_LINES=len(LINES)

        in_print_block = False
        in_print_count = 0
        in_call_count  = 0

        f=open(sys.argv[1],"rb")
        whole_file_x = f.read()
        f.close()

        # The output of this program will be run through diff(1).  To prevent
        # problems on different systems, we are going to allow tabs, newlines,
        # and characters in the decimal 32 through 126 printable character set.

        whole_file = ""
        if sys.version[0] == '2' :
            for ch in whole_file_x :
                if (ord(ch) >= 32 and ord(ch) < 127) or ord(ch) == 9 or ord(ch) == 10 :
                    whole_file += ch
        else :
            for ch in whole_file_x :
                if ( ch >= 32 and ch < 127) or ch == 9 or ch == 10:
                    whole_file += chr(ch)

        whole_file.replace('\r','') # Windows.  Always Windows
        lines = whole_file.split('\n')

        pattern_source = re.compile("^[0-9]+\t")
        pattern_call = re.compile("^[0-9]+\t[ ]*cALl",re.IGNORECASE)
        pattern_entry = re.compile("^.* [(]entry=.*$")
        pattern_frame = re.compile("^#[0-9]+[ ]+0x.*$")
        pattern_breakpoint_at = re.compile("at 0x[0-9a-f]+")
        pattern_breakpoint_in = re.compile("0x[0-9a-f]+\s+in")
        pattern_set_address = re.compile(r"^SET ADDRESS\s+0x([0-9a-f]+)")
        dummy_address = 0
        pattern_process = re.compile('(^.*process )([0-9]+[ ]*)(.*$)')

        ignoring = False

        for line in lines :
            if line.find("IGNORE START") == 0 :
                print(line)
                ignoring = True
            elif line.find("IGNORE FINISH") == 0 :
                ignoring = False
            if ignoring :
                continue

            match = pattern_set_address.match(line)
            if match :
                dummy_address =  int(match.group(1), 16)
                continue

            is_source_line = False
            is_call_line   = False
            ## A source line is GDB echoing a source line.
            ## A source line starts with a number, followed by a tab
            is_source_line = pattern_source.search(line)
            if is_source_line :
                ## Some source lines are call lines
                is_call_line = pattern_call.search(line)

            print_this_line = False
            if line.find(KNOWN_GOOD_PREFIX) == 0 :
                suffix = line[LEN_KNOWN_GOOD_PREFIX:]
                if suffix.find("START") == 0 :
                    in_print_block = True
                    in_print_count = 0
                elif suffix.find("FINISH") == 0 :
                    ## Print out the input line.  If we don't do it here, it won't
                    ## happen at all because we about to turn off the print switches
                    print(line)
                    in_print_block = False
                    in_print_count = 0
                elif suffix.find(LINES) == 0 :
                    in_print_count = int(suffix[LEN_LINES:]) + 1
                else :
                    ## This is an unknown "KNOWN GOOD " continuation
                    ## We will ignore it.
                    pass
            print_this_line = in_print_block
            if in_print_count > 0 :
                print_this_line = True
                in_print_count -= 1

            if print_this_line :
                if not dummy_address == 0:
                ## Some places may output function address for breakpoints:
                ## If enabled replace that with an increasing dummy number and go on 
                   line = pattern_breakpoint_at.sub(f"at {hex(dummy_address)}", line)
                   line = pattern_breakpoint_in.sub(f" {hex(dummy_address)} in", line)
                   dummy_address += 1

            if print_this_line :
                ## In general, when a process ends, it puts up a message like this:
                ##      [Inferior 1 (process 14969) exited normally]
                ## Let's replace the process number with "99999"
                m = pattern_process.match(line)
                if m :
                    print(m.group(1) + "99999" + m.group(3))
                    print_this_line = False

            if print_this_line :
                ## If a line starts with a hex number, it's an address, usually. And
                ## they can change from one run to the next.  Suppress them.
                if line.find("0x") == 0 :
                    print_this_line = False

            if print_this_line :
                if line.find("[Thread ") == 0 :
                    print_this_line = False

            if print_this_line :
                if line.find("Using host ") == 0 :
                    print_this_line = False

            if print_this_line :
                if line.find("Missing separate ") == 0 :
                    print_this_line = False

            if print_this_line :
                if line.find("Registering ") == 0 :
                    print_this_line = False

            if print_this_line :
                if line.find("[New Thread ") == 0 :
                    print_this_line = False

            if print_this_line :
                if line.find("[Switching ") == 0 :
                    print_this_line = False

            if print_this_line :
                if pattern_entry.search(line) :
                    print_this_line = False

            if print_this_line :
                if pattern_frame.search(line) :
                    print_this_line = False

            ##  In the sequence
            ##      10 CALL
            ##          vars1
            ##      60 PROCEDURE
            ##          vars2
            ##      61 MOVE...
            ##          vars3
            ##  we want to skip everything after line 66 until line 77, because
            ##  the trap at line 60 occurs before the linkage variables have been initialized
            ##  and they generally contain unpredictable values.
            ##
            ##  This little state machine accomplishes that.
            if in_call_count and is_source_line :
                in_call_count += 1
                if in_call_count == 2 :
                    print(line)
                if in_call_count > 2 :
                    in_call_count = 0
            if is_call_line :
                in_call_count = 1
            if in_call_count == 2 :
                print_this_line = False;

            if print_this_line :
                print(line)

main()
