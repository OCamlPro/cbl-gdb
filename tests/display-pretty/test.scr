cprint/v5 *
echo TESTING cprint/v6 *\n
cprint/v6 *
echo TESTING cprint/v7 *\n
cprint/v7 *
echo TESTING cprint/v8 *\n
cprint/v8 *

echo TESTING cprint/p *\n
cprint/p *

echo KNOWN GOOD FINISH\n
continue
quit
