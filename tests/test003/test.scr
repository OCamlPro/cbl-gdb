set height 0
set width 0
set breakpoint pending on

define stutter_step
    set variable $_exitcode=1031
    while $_exitcode==1031
        echo 
        cprint *
        cprint ?
        cprint/x 1
        step
        end
    end

file test

cprint/v0

### Make sure we have a known 'cprint ?' range
echo KNOWN GOOD LINES: 2\n
cprint/r 6

### Just run the whole program clean, to establish a baseline
### (We don't want to think we have a debugging problem when
###  in fact it was the test program that changed.)
echo KNOWN GOOD START\n
r
echo KNOWN GOOD FINISH\n

b 9
run
echo KNOWN GOOD START\n
stutter_step
echo KNOWN GOOD FINISH\n
clear 9

## I want to check the 'frame N' handling, but, weirdly,
## GDB 7 generates output on a gdb.execute("frame N",False,True) command
## Hence the START/FINISH pairs sprinkled here.

b INDENTER.cpy:2

echo KNOWN GOOD START\n
r
select-frame 8
cprint *
cprint ?
cprint/x 1
select-frame 7
cprint *
cprint ?
cprint/x 1
select-frame 6
cprint *
cprint ?
cprint/x 1
select-frame 5
cprint *
cprint ?
cprint/x 1
select-frame 4
cprint *
cprint ?
cprint/x 1
select-frame 3
cprint *
cprint ?
cprint/x 1
select-frame 2
cprint *
cprint ?
cprint/x 1
select-frame 1
cprint *
cprint ?
cprint/x 1
select-frame 0
cprint *
cprint ?
cprint/x 1
c
echo KNOWN GOOD FINISH\n

q
