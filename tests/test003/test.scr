set height 0
set width 0
set breakpoint pending on

define stutter_step
    set variable $_exitcode=1031
    while $_exitcode==1031
        echo 
        p *
        p ?
        p/x 1
        step
        end
    end

file test

### Make sure we have a known 'p ?' range
echo KNOWN GOOD LINES: 2\n
p/r 6

### Make sure 'p *' is clean at the beginning
echo KNOWN GOOD LINES: 1\n
p *

### Just run the whole program clean, to establish a baseline
### (We don't want to think we have a debugging problem when
###  in fact it was the test program that changed.)
echo KNOWN GOOD START\n
r
echo KNOWN GOOD FINISH\n

### Make sure 'p *' is clean at the end
echo KNOWN GOOD LINES: 1\n
p *

start
echo KNOWN GOOD START\n
stutter_step
echo KNOWN GOOD FINISH\n

## I want to check the 'frame N' handling, but, weirdly,
## GDB 7 generates output on a gdb.execute("frame N",False,True) command
## Hence the START/FINISH pairs sprinkled here.

b INDENTER.cpy:2

echo KNOWN GOOD START\n
r
echo IGNORE START\n
frame 8
echo IGNORE FINISH\n
p *
p ?
p/x 1
echo IGNORE START\n
frame 7
echo IGNORE FINISH\n
p *
p ?
p/x 1
echo IGNORE START\n
frame 6
echo IGNORE FINISH\n
p *
p ?
p/x 1
echo IGNORE START\n
frame 5
echo IGNORE FINISH\n
p *
p ?
p/x 1
echo IGNORE START\n
frame 4
echo IGNORE FINISH\n
p *
p ?
p/x 1
echo IGNORE START\n
frame 3
echo IGNORE FINISH\n
p *
p ?
p/x 1
echo IGNORE START\n
frame 2
echo IGNORE FINISH\n
p *
p ?
p/x 1
echo IGNORE START\n
frame 1
echo IGNORE FINISH\n
p *
p ?
p/x 1
echo IGNORE START\n
frame 0
echo IGNORE FINISH\n
p *
p ?
p/x 1
c
echo KNOWN GOOD FINISH\n

q
