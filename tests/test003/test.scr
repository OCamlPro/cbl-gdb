set height 0
set width 0
set print repeats 10
set print elements 200
set breakpoint pending on

define stutter_step
    set variable $_exitcode=1031
    while $_exitcode==1031
        echo 
        cprint *
        cprint ?
        cprint/x #1
        step
        end
    end

define printem
    echo KNOWN GOOD START\n
    echo cprint/v0 *\n
    cprint/v0 *
    echo cprint/v0 ?\n
    cprint/v0 ?
    echo cprint/v3 *\n
    cprint/v3 *
    echo cprint/v3 ?\n
    cprint/v3 ?
    echo cprint/x #1\n
    cprint/x #1
    echo cprint/m *\n
    cprint/m *
    echo cprint/m ?\n
    cprint/m ?
    echo KNOWN GOOD FINISH\n
    end

define printloop
    set variable $_exitcode=1031
    while $_exitcode==1031
       printem
       continue
       end
    end

file test
cprint/v3
cprint/r 6

### Just run the whole program clean, to establish a baseline
### (We don't want to think we have a debugging problem when
###  in fact it was the test program that changed.)
echo KNOWN GOOD START\n
r
echo KNOWN GOOD FINISH\n

