set height 0
set width 0
set print repeats 10
set print elements 200

file ./test
cprint/v0

b 14
b 19
b 24
b 30
b 35
b 40

cstart
echo KNOWN GOOD START\n
cprint aflag=false
cprint aflag="x"
cprint aflag=true
cprint aflag=false
continue
cprint/v0 AFLAG
continue
cprint/v1 AFLAG
continue
cprint/v2 AFLAG
continue
cprint/v3 BFLAG
continue
cprint/v6 BFLAG
continue
cprint/v8 BFLAG
cprint AFLAG=BFLAG
echo KNOWN GOOD FINISH\n
continue
quit
