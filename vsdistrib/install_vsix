#! /bin/bash

set -e

# Find the most recent VSIX package, and install it
if [[ -x `command -v code` ]] ; then
	VSIXES=`ls --sort=time cbl-gdb*.vsix`
	if (( ${#VSIXES[@]} >= 1 )) ; then 
		read -ra VSIX <<< "$VSIXES"
		if [[ -e ${VSIX[0]} ]] ; then 
			echo "Installing ${VSIX[0]}"
			code --install-extension "${VSIX[0]}" --user-data-dir=.vscode-root
			rm -fr .vscode-root
			fi
		fi
	fi
