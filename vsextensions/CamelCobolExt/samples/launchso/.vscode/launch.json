{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Script",
            "type": "cbl-gdb",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "ixscript": "/home/bob/.prim_debug/gdb_launcher",
        },
        {
            "name": "Attach to PID",
            "type": "cbl-gdb",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "solibs":"${env:PRIM_LIBRARY_PATH}",
            "process_id": "${input:attachtopid}",
        },
        {
            "name": "Script Server",
            "type": "node",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "ixscript": "/home/bob/.prim_debug/gdb_launcher",
            "debugServer": 4711,
        },
        {
            "name": "PID Server",
            "type": "node",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "solibs":"${env:PRIM_LIBRARY_PATH}",
            "process_id": "${input:attachtopid}",
            "debugServer": 4711,
        },
    ],
    "inputs": [
        {
            "id": "attachtopid",
            "type": "promptString",
            "description": "Enter the PID to attach to",
            "default": ""
        }
    ]
}