usage()
  {
  echo "This is the cobc debugging wrapper $1 $2"
  }

print_help()
  {
  echo "This is the cobc debugging wrapper $1 $2"
  echo "Use it as you would 'cobc'"
  echo ""
  echo "It doesn't take any switches except --help and --version"
  echo ""
  echo "If there is a -T or -t switch, the unmodified cobc compile will take place to generate"
  echo "the listing file before the more complex debug build is done."
  echo ""
  echo "It can be controlled by a few environment variables:"
  echo "COBCD_COBC=alt     Replaces 'cobc' with 'alt'"
  echo "COBC=alt           Also replaces 'cobc' with 'alt'"
  echo "COBCDEVEL=1        Use development toolchain instead of production toolchain"
  echo "COBCDNOCLEAN=1     Don't delete intermediate files"
  echo "COBCDFLAGS=xyz     These flags are passed to cobc"
  echo "COBCDXM=[-x|-m|-b] cobc assumes a default of -m"
  echo "ECHO=1             Causes line-by-line command echoing"
  echo ""
  echo "If you need help with cobc, use the command 'cobc --help'"
  }

###########################################################################
## The version number in the next line is updated by a Linux bash script. #
## The text "Version x.x" has to appear in square brackets.               #
## Don't mess with it!                                                    #
###########################################################################

SCRIPT_VERSION="[Version 3.13]"

# This script, nominally named cobcd, packages up the process of compiling
# a single COBOL source module and processing it so that gdb can be used for
# source-level debugging of that module. Found in the root folder of the
# cbl-gdb repository, it is designed to operate there pointing at the development
# versions of the processing programs as controlled by the external environment
# variables COBCDEVEL and COBCDNOCLEAN.  Once installed in, say, /usr/local/bin,
# it will use production versions of the processing programs
#
# Usage:
# cobcd source.cbl ## Uses production toolchain.  Any switches before the source
# module are incorporated in the part of the process that creates the .C module,
# and any switches after the source module are included in the final link.
#
# Recall that this script is good for compiling a single source module; at this
# writing we don't handle executables created from multiple source modules.
#
# Environment variable control:
# COBCDEVEL=1 ## Causes the use of the development toolchain rather than the
#             ## production toolchain.
#
# COBCDNOCLEAN=1 ## For development. The intermediate files will find their way
#                ## into the current working directory, instead of being
#                ## deleted after the compilation is complete.
#
# COBCDFLAGS ## Use for things like --free
#
# COBCDXM=[-x|-m|-b] ## cobc assumes a default of -m
#
# COBCD_COBC=alt (or COBC, for that matter) replaces 'cobc' with 'alt'
#
# ECHO=1 causes massive debugging output

if [ X"$#" = X"0" ]
  then
  usage $SCRIPT_VERSION
  echo "Use it as you would 'cobc'"
  exit 1
  fi

set +e  ## This kind of needs to be +e in order to make sure intermediate files
        ## get cleaned up in the event of compilation errors
#set -x ## This turns on shell echoing
#ECHO=1  ## This turns on *my* echoing

if uname -m | grep -qs x86_64 ; then
  platform=x86_64
  fi

if uname -m | grep -qs arm ; then
  platform=arm
  fi

if grep -qs debian /etc/os-release ; then
  os_name=debian
  fi

if grep -qs centos /etc/os-release ; then
  os_name=centos
  fi

if uname -r | grep -qs el7 ; then
  os_name=rhel7
  fi

if uname | grep -qs MINGW32_NT ; then
  os_name=MINGW32_NT
  fi

if uname | grep -qs MINGW64_NT ; then
  os_name=MINGW64_NT
  fi

if uname | grep -qs MSYS_NT ; then
  os_name=MSYS_NT
  fi

## We need to know the directory that our script is in.
SCRIPTDIR=$(dirname $(realpath $0))

# set COBCD to COBCD_COBC or COBCD if provided, or "cobc" by default
if [ X"$COBCD_COBC" != X"" ] ; then
  COBC="$COBCD_COBC"
elif [ X"$COBC" = X"" ] ; then
  COBC=cobc
  fi

if [ "$COBCDEVEL" ]; then
  ## For development purposes, pick up executables from subdirectories
  ## from where the cobcd script was found
  COBST=$SCRIPTDIR/cobcd-st/cobcd-st
  SFIX=$SCRIPTDIR/cobcd-sfix/cobcd-sfix
  PYTHON=$SCRIPTDIR/python/cobcd.py

  # for COBCDEVEL, we embed the script
  DASH_F=""
  DASH_S=-s
else
  # In normal operation, the executables are found in the same folder
  # as the cobcd script
  COBST=$SCRIPTDIR/cobcd-st
  SFIX=$SCRIPTDIR/cobcd-sfix
  PYTHON=$SCRIPTDIR/cobcd.py

  # In normal operation, we embed a pointer
  DASH_F="-f"
  DASH_S=""
  fi

## However, -s doesn't work in RHEL7:
if [ "$os_name" = "rhel7" ]
  then
  DASH_F="-f"
  DASH_S=""
  fi

## We need to extract the COB_CFLAGS information from `cobc --info`
## in case we need to augment COB_CFLAGS when we actually use cobc.

cobc_info=`$COBC --info | sed 's/\n/ /g'`
cob_cflags=$(echo $cobc_info | sed 's/.*COB_CFLAGS\s\+:\s\+\(.*\)COB_LDFLAGS.*/\1/')

#echo cob_cflags is $cob_cflags

## Build up the entire original set of parameters:

COMMAND_LINE=""
ASKED_FOR_HELP=""
ASKED_FOR_VERSION=""
DASH_V=""
T_FLAG=""
SOURCEFILE=""

while [ "$#" != "0" ]
  do
  if [ X"$1" = X"--help" ]
    then
    ASKED_FOR_HELP=yes
    fi
  if [ X"$1" = X"--version" ]
    then
    ASKED_FOR_VERSION=yes
    fi
  if [ X"$1" = X"-v" ]
    then
    DASH_V=-v
    fi
  if echo $1 | grep -iqs -e "-t"
    then
    T_FLAG=yes
    fi
  case $1 in
    -x|-m|-b)
      COBCDXM=$1
      ;;
    esac
  COMMAND_LINE="$COMMAND_LINE $1"
  shift
  done

if [ "$COBCDXM" = "" ]
  then
  COBCDXM=-m
  fi

if [ $ASKED_FOR_HELP ]
  then
  print_help $SCRIPT_VERSION
  fi

if [ $ASKED_FOR_VERSION ]
  then
  usage $SCRIPT_VERSION
  $COBST -v
  $SFIX -v
  $COBC --version
  exit 0
  fi

result="0"

## If he is doing something that requires a straight cobc compilation
## with a -t or -T switch, do it now.
if [ "$result" = "0" ]
  then
  if [ "$T_FLAG" = "yes" ]
    then
    if [ "$ECHO" ]
      then
      echo $COBC $COBCDFLAGS $DASH_V $COMMAND_LINE
      fi
    echo "Performing original"
    $COBC $COBCDFLAGS $DASH_V $COMMAND_LINE
    result=$?

    ## Strip the -t/-T stuff out of the command line so that it doesn't
    ## interfere with our subsequent processing:
    COMMAND_LINE=$(echo $COMMAND_LINE | sed 's/\s\+-t\s*\S\+/ /gi')
    fi
else
  exit 1
  fi

## Strip out things that will cause trouble for us if they are there:
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -v / /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -v$/ /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/^-v / /g')

COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -x / /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -x$/ /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/^-x / /g')

COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -b / /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -b$/ /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/^-b / /g')

COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -m / /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -m$/ /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/^-m / /g')

COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -c / /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -c$/ /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/^-c / /g')

COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -C / /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -C$/ /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/^-C$/ /g')

COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -g / /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -g$/ /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/^-g / /g')

COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -S / /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -S$/ /g')

COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -debug/ /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/^-debug / /g')

COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -d / /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/ -d$/ /g')
COMMAND_LINE=$(echo $COMMAND_LINE | sed -e 's/^-d / /g')

# Let's find out what the original input and output parameters are from
# the slightly modified original command line:

## The actual information we need is in stderr, and we need to get
## rid of the stuff from stdout because it ends up at the end of the
## the string, and later on we'll need the stuff from the final -###
## entry, and I can't figure out how to isolate it from the stdout stuff

TRIPLE_X_COMMAND="$COBCDXM $COBCDFLAGS $COMMAND_LINE"

TFILE=/tmp/$$triplex
$COBC -### $TRIPLE_X_COMMAND 1>/dev/null 2>$TFILE
TRIPLE_X_PRIME=$(cat $TFILE | sed 's/\n/ /g')
rm $TFILE

## The COBOL source file is last thing before " preprocessing: "
FILE_CBL=$(echo $TRIPLE_X_PRIME | sed -e 's/.* \(\S\+\) preprocessing: .*/\1/')

## Come up with TRIPLE_X for the -S command:
OUR_COMMAND="-S -g -fec=PROGRAM-ARG-OMITTED --fgen-c-line-directives --fgen-c-labels $COBCDXM $COBCDFLAGS $COMMAND_LINE"
## If we were supplied with a -o switch, it screws things up at this point.  So, let's get rid of it, if it is there
OUR_COMMAND=$(echo $OUR_COMMAND | sed 's/\s\+-o\s*\S\+/ /')
TRIPLE_X=$($COBC -### $OUR_COMMAND 2>&1)

## The .s file name is first thing after the last " -o "
FILE_S=$(echo $TRIPLE_X | sed -e 's/.* -o //' | cut -d ' ' -f 1)
## Get rid of the quotation marks
FILE_S=$(echo $FILE_S | sed -e 's/"//g')

## Strip off the .s to get the file root:
FILE_ROOT=$(echo $FILE_S | sed -e 's/[.]s//g')

## Create some other names
FILE_C=$FILE_ROOT.c
FILE_O=$FILE_ROOT.o
FILE_LST=$FILE_ROOT.cbl.lst
FILE_SYM_C=$FILE_ROOT.sym.c
FILE_SYM_O=$FILE_ROOT.sym.o

if [ $ECHO ]
  then
  echo "platform   is $platform   "
  echo "os_name    is $os_name    "
  echo "COBCDEVEL  is $COBCDEVEL    "
  echo "COBST      is $COBST      "
  echo "SFIX       is $SFIX       "
  echo "PYTHON     is $PYTHON     "
  echo "FILE_ROOT  is $FILE_ROOT  "
  echo "FILE_CBL   is $FILE_CBL   "
  echo "FILE_LST   is $FILE_LST   "
  echo "FILE_C     is $FILE_C     "
  echo "FILE_S     is $FILE_S     "
  echo "FILE_O     is $FILE_O     "
  echo "FILE_SYM_C is $FILE_SYM_C "
  echo "FILE_SYM_O is $FILE_SYM_O "
  fi

## Do the initial compilation that gives us the .c .h .i and .s files
## Rebuild our command, this time with our -T directive:
OUR_COMMAND="-S -g -fec=PROGRAM-ARG-OMITTED --fgen-c-line-directives --fgen-c-labels -T $FILE_LST --tlines=0 --tsymbols $COBCDXM $COBCDFLAGS $COMMAND_LINE"
OUR_COMMAND=$(echo $OUR_COMMAND | sed 's/\s\+-o\s*\S\+/ /')

if [ "$ECHO" ]
  then
  echo $COBC $DASH_V $OUR_COMMAND
  fi
$COBC $DASH_V $OUR_COMMAND
result=$?

## In the Windows universe, we can't embed anything into the executable
case "$os_name" in
  "MINGW32_NT"|"MINGW64_NT"|"MSYS_NT")
    DASH_F=""
    DASH_S=""
  esac
  
if [ "ECHO" ]
  then
  DASH_Q=-q
  fi

## We can now create the .sym.c file:
if [ "$result" = "0" ]
  then
  if [ "$ECHO" ]
    then
    echo $COBST $DASH_Q $DASH_F $DASH_S $FILE_ROOT $FILE_CBL
    fi
  $COBST $DASH_Q $DASH_F $DASH_S $FILE_ROOT $FILE_CBL
  result=$?
  fi

## We can now compile the .sym.c file:
if [ "$result" = "0" ]
  then
  if [ "$ECHO" ]
    then
    echo $COBC $DASH_V -c -o $FILE_SYM_O $FILE_SYM_C
    fi
  $COBC $DASH_V -c -o $FILE_SYM_O $FILE_SYM_C
  result=$?
  fi

## It is time to modify the .s file
if [ "$result" = "0" ]; then
  # Modify the .s file, removing all .loc references to
  # FILE_ROOT.c and any .h files.  The modification is done "in-place".
  if [ "$ECHO" ]; then
    echo $SFIX $DASH_Q $FILE_S $FILE_S $FILE_C $FILE_CBL
    fi
  $SFIX $DASH_Q $FILE_S $FILE_S $FILE_C $FILE_CBL
  result=$?
  fi

## We can now compile that .s file:

OUR_COMMAND="-c -g -d $COBCDXM $COBCDFLAGS -o $FILE_O $FILE_S"

if [ "$result" = "0" ]; then
  if [ "$ECHO" ]; then
    echo $COBC $DASH_V $OUR_COMMAND
    fi
  $COBC $DASH_V $OUR_COMMAND
  result=$?
  fi

## It's time to put everything together

## Find the final "to be executed: " string
FINAL_COMMAND=$(echo $TRIPLE_X_PRIME | sed 's/.*to be executed: //g')
## When compiling with -x, there is something like "/tmp/cob2458_0.o"
## in that command.  Replace it with our .o files:
FINAL_COMMAND=$(echo $FINAL_COMMAND | sed "s|\"/.*[.]o\"|$FILE_O $FILE_SYM_O|g")
## When compiling with -m, there is something like "/tmp/cob2458_0.c"
## in that command.  Replace it with our .o files:
FINAL_COMMAND=$(echo $FINAL_COMMAND | sed "s|\"/.*[.]c\"|$FILE_O $FILE_SYM_O|g")
##
## The FINAL_COMMAND can be, oddly, littered with double quotes.  Let's get rid of them, under the
## assumption that naming files with double quotes is a really bad thing.
FINAL_COMMAND=$(echo $FINAL_COMMAND | sed "s|\"||g")

if [ "$result" = "0" ]; then
  # Modify the .s file, removing all .loc references to
  # BASENAME.c and any .h files.
  if [ "$ECHO" ]; then
    echo $FINAL_COMMAND $DASH_V
    fi
  $FINAL_COMMAND $DASH_V
  result=$?
  fi

## And we have a debuggable executable

## Some operating systems, notably Windows, require that a
## copy of the Python code be placed next to the executable:
if [ "$result" = "0" ]; then
  if [ -z $DASH_S ] && [ -z $DASH_F ]
    then
    ## Because we didn't embed a pointer or the script, we need to
    ## make a local copy
    if [ -f $PYTHON ]
      then
        if [ -z $PYTHON_DESTINATION ]
          then
          ## The destination is the first thing after the -o:
          PYTHON_DESTINATION=$(echo $FINAL_COMMAND | sed 's/.* -o //' | cut -d ' ' -f 1)
          PYTHON_DESTINATION=$(realpath $PYTHON_DESTINATION)
          PYTHON_DESTINATION=$(dirname $PYTHON_DESTINATION)
          echo $PYTHON_DESTINATION
          fi
        if [ -z $PYTHON_NAME ]
          then
          PYTHON_NAME="$FILE_ROOT-gdb.py"
          fi

        if [ $ECHO ]
          then
          echo "cp $PYTHON $PYTHON_DESTINATION/$PYTHON_NAME"
          fi
      cp $PYTHON $PYTHON_DESTINATION/$PYTHON_NAME
    else
      echo ERROR: "Couldn't find a copy of cobcd.py"
      fi
    fi
  fi

## clean up after ourselves, assuming that's desired
if [ -z "$COBCDNOCLEAN" ];
    then
    rm -fr $FILE_ROOT.[csio]
    rm -fr $FILE_ROOT*.h
    rm -fr $FILE_LST
    rm -fr $FILE_O
    rm -fr $FILE_ROOT.sym.[co]
    fi

exit $result
