#!/bin/sh

usage()
  {
  echo "This is the cobc debugging wrapper $1 $2"
  echo "Use it as you would 'cobc'"
  }

print_help()
  {
  echo "This is the cobc debugging wrapper $1 $2"
  echo "Use it as you would 'cobc'"
  echo ""
  echo "It doesn't take any switches, although it looks at a few as they"
  echo "go by on their way to cobc."
  echo ""
  echo "It can be controlled by a few environment variables:"
  echo "COBCD_COBC=alt Replaces 'cobc' with 'alt'"
  echo "COBC=alt Also replaces 'cobc' with 'alt'"
  echo "COBCDEVEL=1 Use development toolchain instead of production toolchain"
  echo "COBCDNOCLEAN=1 Don't delete intermediate files"
  echo "COBCDFLAGS=xyz These flags are passed to cobc"
  echo "COBCDXM=[-x|-m|-b] cobc assumes a default of -m"
  echo "ECHO=1 causes line-by-line command echoing"
  echo ""
  echo "If you need help with cobc, use the command 'cobc --help'"
  }

###########################################################################
## The version number in the next line is updated by a Linux bash script. #
## The text "Version x.x" has to appear in square brackets.               #
## Don't mess with it!                                                    #
###########################################################################

SCRIPT_VERSION="[Version 3.3]"

# This script, nominally named cobcd, packages up the process of compiling
# a single COBOL source module and processing it so that gdb can be used for
# source-level debugging of that module. Found in the root folder of the
# cbl-gdb repository, it is designed to operate there pointing at the development
# versions of the processing programs as controlled by the external environment
# variables COBCDEVEL and COBCDNOCLEAN.  Once installed in, say, /usr/local/bin,
# it will use production versions of the processing programs
#
# Usage:
# cobcd source.cbl ## Uses production toolchain.  Any switches before the source
# module are incorporated in the part of the process that creates the .C module,
# and any switches after the source module are included in the final link.
#
# Recall that this script is good for compiling a single source module; at this
# writing we don't handle executables created from multiple source modules.
#
# Environment variable control:
# COBCDEVEL=1 ## Causes the use of the development toolchain rather than the
#             ## production toolchain.
#
# COBCDNOCLEAN=1 ## For development. The intermediate files will find their way
#                ## into the current working directory, instead of being
#                ## deleted after the compilation is complete.
#
# COBCDFLAGS ## Use for things like --free
#
# COBCDXM=[-x|-m|-b] ## cobc assumes a default of -m
#
# COBCD_COBC=alt (or COBC, for that matter) replaces 'cobc' with 'alt'
#
# ECHO=1 causes massive debugging output

if [ X"$#" = X"0" ]
  then
  usage $SCRIPT_VERSION
  exit 1
  fi

set +e  ## This kind of needs to be +e in order to make sure intermediate files
        ## get cleaned up in the event of compilation errors
#set -x ## This turns on shell echoing
#ECHO=1  ## This turns on *my* echoing

if uname -m | grep -qs x86_64 ; then
  platform=x86_64
  fi

if uname -m | grep -qs arm ; then
  platform=arm
  fi

if grep -qs debian /etc/os-release ; then
  os_name=debian
  fi

if grep -qs centos /etc/os-release ; then
  os_name=centos
  fi

if uname -r | grep -qs el7 ; then
  os_name=rhel7
  fi

if uname | grep -qs MINGW32_NT ; then
  os_name=MINGW32_NT
  fi

if uname | grep -qs MINGW64_NT ; then
  os_name=MINGW64_NT
  fi

if uname | grep -qs MSYS_NT ; then
  os_name=MSYS_NT
  fi

## We need to know the directory that our script is in.
SCRIPTDIR=$(dirname $(realpath $0))

# set COBCD to COBCD_COBC or COBCD if provided, or "cobc" by default
if [ X"$COBCD_COBC" != X"" ] ; then
  COBC="$COBCD_COBC"
elif [ X"$COBC" = X"" ] ; then
  COBC=cobc
  fi

# pick up GCC from `cobc --info`
GCC=`$COBC --info | grep COB_CC | cut -d: -f2`

if [ "$COBCDEVEL" ]; then
  # For development purposes, pick up executables from subdirectories
  # from where the cobcd script was found
  COBST=$SCRIPTDIR/cobcd-st/cobcd-st
  SFIX=$SCRIPTDIR/cobcd-sfix/cobcd-sfix
  PYTHON=$SCRIPTDIR/python/cobcd.py
else
  # In normal operation, the executables are found in the same folder
  # as the cobcd script
  COBST=$SCRIPTDIR/cobcd-st
  SFIX=$SCRIPTDIR/cobcd-sfix
  PYTHON=$SCRIPTDIR/cobcd.py
  fi

# Under centos7/rhel7, we don't allow cobcd-st to embed the Python code
# into the .sym.c module
case "$os_name" in
     "rhel7")
        COBST_FLAGS=-n
        ;;
  esac

## We need to extract the COB_CFLAGS information from `cobc --info`
## in case we need to augment COB_CFLAGS when we actually use cobc.

cobc_info=`$COBC --info | sed 's/\n/ /g'`
cob_cflags=$(echo $cobc_info | sed 's/.*COB_CFLAGS\s\+:\s\+\(.*\)COB_LDFLAGS.*/\1/')

#echo cob_cflags is $cob_cflags

#
# We need to do some processing on the input parameters.
#
# 1) We are going to make the assumption that the cobol module
#    has the extension .cbl.
# 2) We are going to assume that any -o option is followed by the executable
#    target name; we'll handle that with a final filemove
# 3) Any other options that appear before the filename will be accumulated
#    into PREOPTIONS
# 4) Any other options that appear after the filename will be accumulated
#    into POSTOPTIONS.  Post options go at the end of the second call to
#    COBC, which links object files into executables
#
# We are also going to maintain a copy of the original command sequence. We
# will be running that separately just be sure that if the user wants something
# I have been unable to anticipate, that it gets done properly.

ORIGINAL=""
SOURCEFILE=""
BASENAME=""
TARGET=""
PREOPTIONS=""
POSTOPTIONS=""
ORIGINALRUN="no"

#
# Because we need to have control over the intermediate files, and because
# the -save-temps switch works by creating the intermediate files locally and
# then moving them, and because the -g switch prevents the -save-temps switch
# from working properly, we have a problem.  For our purposes, all of those
# things are bad things.  We don't know exactly what the user might have in
# mind, and all of that creating and moving can result in our tripping on
# ourselves.  For example, I ran into trouble when one of the COBOL85 test
# programs provided by GnuCOBOL added a '-t something.lst' switch, which
# produced a compile error because I also have a '-T switch'.
#
# I tried creating a temporary directory and compiling from there, but ran
# into a NIST test case that had a COPY SOMEBOOK IN ../ELSEWHERE.  So, instead
# of that, I am now copying SOURCE.CBL into SOURCE-=-$PID.CBL.  Even though
# the intermediate files get created in the current directory, I have control
# over them and (unless I get lottery-winning unlucky) they won't interfere
# with anything else the user has in mind.
#

JUSTPUSH="no"
while (( $# )) ; do
  # Append the unaltered parameter to the list of original parameters.
  ORIGINAL="$ORIGINAL $1"

  PARM=$1  ## Our version of the parameter; we might modify it
  FIRSTCHAR="${PARM:0:1}"
  FIRSTTHREE="${PARM:0:3}"

  if [ "$FIRSTCHAR" != "-" ]; then
    # The first character is not a '-', so this is not a switch.

    # In the case where the filename is part of an double-entry switch (e.g.,
    # "-L <directory>" we will have set JUSTPUSH to "yes"

    if [ "$JUSTPUSH" = "yes" ]; then
      JUSTPUSH="no"
      # Put the parameter into the right list:
      if [ -z "$SOURCEFILE" ]; then
        PREOPTIONS="$PREOPTIONS $PARM"
      else
        POSTOPTIONS="$POSTOPTIONS $PARM"
        fi
    else
      # If you get here, then you have a file name, and it wasn't preceded by
      # any switch explaining what to do with it.  So, in our simple universe
      # of an executable built from a single source modules) it must be the
      # the primary source code module:
      SOURCEFILE=$PARM

      # Extract any extension
      EXT="${1##*.}"

      # Extract the basename
      BASENAME=`basename $PARM .$EXT`

      fi
  else
    # The first character is a '-', so this is a switch
    if [ "$PARM" = "-o" ]; then
      # This is a -o switch.
      # Save the parameter as our ultimate target
      shift
      PARM=$1
      TARGET=$PARM
    elif [ "$PARM" = "--version" ] ; then
      PRINT_VERSION=yes
      if [ -z "$SOURCEFILE" ]; then
        PREOPTIONS="$PREOPTIONS $PARM"
      else
        POSTOPTIONS="$POSTOPTIONS $PARM"
        fi
    elif [ "$PARM" = "--help" ] ; then
      print_help $SCRIPT_VERSION
      exit 1
    elif [ "$FIRSTTHREE" = "-t=" ] || [ "$FIRSTTHREE" = "-T=" ]; then
      # We know a -t=this or -T=that switch will break our compilation, so just ignore it
      ORIGINALRUN="yes"
    elif [ "$PARM" = "-t" ] || [ "$PARM" = "-T" ]; then
      # We know a -t <file> or -T <file> switch will break our compilation, so
      # ignore the switch and the following parameter
      ORIGINALRUN="yes"
      shift
    elif [ "$PARM" = "-x" ] || [ "$PARM" = "-m" ] || [ "$PARM" = "-b" ]; then
      # A command-line parameter overwhelms anything
      # we inherited
      COBCDXM=$PARM
    elif [ "$PARM" = "-I" ] || [ "$PARM" = "-L" ] || [ "$PARM" = "-l" ] || \
         [ "$PARM" = "-D" ] || [ "$PARM" = "-A" ] || [ "$PARM" = "-Q" ] || \
         [ "$PARM" = "-K" ] || [ "$PARM" = "-ext" ]; then
      # We need this switch...
      if [ -z "$SOURCEFILE" ]; then
        PREOPTIONS="$PREOPTIONS $PARM"
      else
        POSTOPTIONS="$POSTOPTIONS $PARM"
        fi
      # ...and the parameter that follows
      JUSTPUSH="yes"
    else
      # Otherwise, add to PRE or POST options
      if [ -z "$SOURCEFILE" ]; then
        PREOPTIONS="$PREOPTIONS $PARM"
      else
        POSTOPTIONS="$POSTOPTIONS $PARM"
        fi
      fi
    fi
  shift
  done

if [ -z "$COBCDXM" ]; then
  # If neither -x nor -m nor -b was specified, explicitly match the COBC default of -m
  COBCDXM=-m
  fi

# For our purposes, we need to strike any leading path from the BASENAME:
BASENAME="${BASENAME##/*}"

# If there is no specific target, create one based on the source file name;
# it'll be put in the current working directory
if [ -z "$TARGET" ]; then
  TARGET=$BASENAME
  if [ "$COBCDXM" = "-m" ] || [ "$COBCDXM" = "-b" ]  ; then
    TARGET=$TARGET.so
    fi
  fi

if [ $BASENAME ]
  then
  TRUEBASENAME=$BASENAME
  TRUESOURCEFILE=$SOURCEFILE
  SOURCEFILE=$(echo $SOURCEFILE | sed "s/$TRUEBASENAME/$TRUEBASENAME/")
  BASENAME=$(echo $BASENAME | sed "s/$TRUEBASENAME/$TRUEBASENAME/")
  fi

if [ "$ECHO" ]; then
  echo platform       $platform
  echo os_name        $os_name
  echo GCC            $GCC
  echo CC1            $CC1
  echo ASSEMBLER      $ASSEMBLER
  echo LOADER         $LOADER
  echo COBC           $COBC
  echo cob_cflags     $cob_cflags
  echo SCRIPTDIR      $SCRIPTDIR
  echo COBST          $COBST
  echo COBST_FLAGS    $COBST_FLAGS
  echo SFIX           $SFIX
  echo PYTHON         $PYTHON
  echo COBCDEVEL      $COBCDEVEL
  echo COBCDNOCLEAN   $COBCDNOCLEAN
  echo COBCDXM        $COBCDXM
  echo ORIGINAL       $ORIGINAL
  echo PREOPTIONS     $PREOPTIONS
  echo TRUESOURCEFILE $TRUESOURCEFILE
  echo TRUEBASENAME   $TRUEBASENAME
  echo SOURCEFILE     $SOURCEFILE
  echo BASENAME       $BASENAME
  echo POSTOPTIONS    $POSTOPTIONS
  echo TARGET         $TARGET
  set | grep COB
  fi

if [ X$PRINT_VERSION = X"yes" ]
  then
  usage $SCRIPT_VERSION
  fi

#
# First, we sometimes execute the original command, unaltered. The need for this
# became clear when replaced the 'cobc' command in the GnuCOBOL 'make tests'
# chain and saw a number of errors in the COBOL85 test suite.  The generated
# code was okay, but there were some tests of the compiler being done as well,
# and it's easier to just run the original command than it is to parse
# everything out and try to duplicate it:

result="0"

if [ "$result" = "0" ]; then
  if [ "$ORIGINALRUN" = "yes" ]; then
    if [ "$ECHO" ]; then
      echo $COBC $COBCDFLAGS $ORIGINAL
      fi
    $COBC $COBCDFLAGS $ORIGINAL
    result=$?
    fi
  fi

if [ "$result" = "0" ] ; then
  if [ -z "$BASENAME" ]; then
      echo "There doesn't seem to be a source file specified."
      echo "We can't proceed with the debug-capable build."
      exit 1
      fi
  fi

## In this step, we do a partial compilation that ends with the creation
## of the .c and .s intermediate files:

if [ "$result" = "0" ]; then
  COB_CFLAGS="-fPIC -Wa,-L $cob_cflags"
  if [ "$ECHO" ]; then
    echo COB_CFLAGS=$COB_CFLAGS $COBC $COBCDFLAGS -S $COBCDXM -d -g \
    --fgen-c-line-directives --fgen-c-labels \
    -T $BASENAME.cbl.lst --tlines=0 --tsymbols $PREOPTIONS $SOURCEFILE
    fi
         COB_CFLAGS=$COB_CFLAGS $COBC $COBCDFLAGS -S $COBCDXM -d -g \
    --fgen-c-line-directives --fgen-c-labels \
    -T $BASENAME.cbl.lst --tlines=0 --tsymbols $PREOPTIONS $SOURCEFILE
  result=$?
  fi

## In this step, we run the COBST program, which combines information
## from BASENAME.lst and the .h files to create BASENAME.sym.c

if [ "$result" = "0" ]; then
  if [ "$ECHO" ]; then
    echo $COBST -q $COBST_FLAGS $BASENAME
    fi
  $COBST -q $COBST_FLAGS $BASENAME
  result=$?
  fi

## In this step, we compile the BASENAME.sym.c, creating BASENAME.sym.o
## It contains the VARIABLE_STRING and the cobcd.py script
if [ "$result" = "0" ]; then
  if [ "$ECHO" ]; then
    echo $COBC -c -o $BASENAME.sym.o $BASENAME.sym.c
    fi
  $COBC -c -o $BASENAME.sym.o $BASENAME.sym.c
  result=$?
  fi

## In this step, we modify the .s file we created earlier.  The SFIX
## program removes all .loc references to BASENAME.C and to any .h
## files.

if [ "$result" = "0" ]; then
  # Modify the .s file, removing all .loc references to
  # BASENAME.c and any .h files.
  if [ "$ECHO" ]; then
    echo $SFIX -q $BASENAME.s $BASENAME-2.s $BASENAME.c $SOURCEFILE
    fi
  $SFIX -q $BASENAME.s $BASENAME-2.s $BASENAME.c $SOURCEFILE
  result=$?
  fi

## In this step, we invoke COBC to run the assembler on the modified BASENAME-2.s
## in order to create BASENAME-2.o file

if [ "$result" = "0" ]; then
  # Assemble the modified .s file into a replacement .o file:
  COB_CFLAGS="-fPIC -Wa,-L,-anchls=$BASENAME-2.lst $cob_cflags"
  if [ "$ECHO" ]; then
    echo COB_CFLAGS=$COB_CFLAGS $COBC -c -o $BASENAME-2.o $BASENAME-2.s
    fi
  COB_CFLAGS=$COB_CFLAGS $COBC -c -o $BASENAME-2.o $BASENAME-2.s
  result=$?
  fi

## In this step, we combine the two .o files to create the executable
if [ "$result" = "0" ]; then
  # Combine the two .o files to create the executable
  # Stay in the original directory so that $TARGET, if relative, ends up in
  # the right place.

  if [ "$COBCDXM" = "-x" ]; then
    if [ "$ECHO" ]; then
      echo $COBC $COBCDXM -o $TARGET $BASENAME-2.o $BASENAME.sym.o $POSTOPTIONS
      fi
    $COBC $COBCDXM -o $TARGET $BASENAME-2.o $BASENAME.sym.o $POSTOPTIONS
  else
    if [ "$ECHO" ]; then
      echo $GCC -shared -o $TARGET $BASENAME-2.o $BASENAME.sym.o -lcob $POSTOPTIONS
      fi
    $GCC -shared -o $TARGET $BASENAME-2.o $BASENAME.sym.o -lcob $POSTOPTIONS

    if [ "$os_name" = "MINGW32_NT" ] || [ "$os_name" = "MINGW64_NT" ] || [ "$os_name" = "MSYS_NT" ]; then
        mv $TARGET $BASENAME.dll
        fi
    fi
  fi

## In this step, we put a copy of the cobcd.py into the right place,
## if it is necessary for this operating system:

#### Bob: if $os_name is guaranteed to exist, the variable need not be quoted:
####
####    case $os_name in
####	MINGW32_NT|MINGW64_NT|MSYS_NT|centos7|rhel7)
####
#### is more commonly used.

if [ "$result" = "0" ]; then
    case "$os_name" in
	"MINGW32_NT"|"MINGW64_NT"|"MSYS_NT"|"centos7"|"rhel7")
	    if [ -f $PYTHON ]; then
		cp $PYTHON ./$BASENAME-gdb.py
	    else
		echo ERROR: "Couldn't find a copy of cobcd.py"
	    fi
    esac
fi

if [ -z "$COBCDNOCLEAN" ]; then
    rm -fr = $BASENAME.[csio] $BASENAME*.h $BASENAME.lst \
    $BASENAME.cbl.lst $BASENAME.full.tab $BASENAME.tab \
    $BASENAME.cbl.o $BASENAME-2.lst $BASENAME.sym.[co] \
    $BASENAME-2.[so]
    fi
