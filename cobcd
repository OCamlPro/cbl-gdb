#!/bin/bash

# This script, nominally named cobcd, packages up the process of compiling
# a single COBOL source module and processing it so that gdb can be used for
# source-level debugging of that module. Found in the root folder of the
# cbl-gdb repository, it is designed to operate there pointing at the development
# versions of the processing programs as controlled by the external environment
# variables COBCDEVEL and COBCDNOCLEAN.  Once installed in, say, /usr/local/bin,
# it will use production versions of the processing programs
#
# Standard disclaimer: Your author is neither pyschic nor omnipotent, so please,
# blame him not if you can't make this script do what you need. Edit it as
# necessary, with his blessing.
#
# Usage:
# cobcd source.cbl ## Uses production toolchain.  Any switches before the source
# module are incorporated in the part of the process that creates the .C module,
# and any switches after the source module are included in the final link.
#
# Recall that this script is good for compiling a single source module; at this
# writing we don't handle executables created from multiple source modules.
#
# Environment variable control:
# COBCDEVEL=1 ## Causes the use of the development toolchain rather than the
#             ## production toolchain.
#
# COBCDNOCLEAN=1 ## For development. The intermediate files will find their way
#                ## into the current working directory, instead of being
#                ## deleted after the compilation is complete.
#
# COBCDFLAGS ## Use for things like --free
#
# COBCDXM=[-x|-m] ## cobc assumes a default of -m

set +e  ## This kind of needs to be +e in order to make sure intermediate files
        ## get cleaned up in the event of compilation errors
#set -x ## This turns on shell echoing
#ECHO=1  ## This turns on *my* echoing

unset COB_SWITCH_1

if grep -q debian /etc/os-release ; then
  os_name=debian
  fi
if grep -q centos /etc/os-release ; then
  os_name=centos
  fi

if  uname -a | grep -q x86_64 ; then
  platform=x86_64
  fi

if  uname -a | grep -q arm ; then
  platform=arm
  fi

# Courtesy of stackoverflow, a script to find the directory of the script
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ] ; do # resolve $SOURCE until the file is no longer a symlink
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ X$SOURCE != X/* ]] && SOURCE="$DIR/$SOURCE" # if $SOURCE was a relative symlink, we need to resolve it relative to the path where the symlink file was located
done
DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

GCC=gcc
COBC=cobc
CC1=`$GCC --print-prog-name cc1`
ASSEMBLER=`$GCC --print-prog-name as`
LOADER=`$GCC --print-prog-name ld`

if test X"$COBCDEVEL" != X"" ; then
  COBST=$DIR/cobst/cobst
  SFIX=$DIR/sfix/sfix
else
  COBST=cobst
  SFIX=sfix
  fi

#
# We need to do some processing on the input parameters.
#
# 1) We are going to make the assumption that the cobol module
#    has the extension .cbl.
# 2) We are going to assume that any -o option is followed by the executable
#    target name; we'll handle that with a final filemove
# 3) Any other options that appear before the filename will be accumulated
#    into PREOPTIONS
# 4) Any other options that appear after the filename will be accumulated
#    into POSTOPTIONS.  Post options go at the end of the second call to
#    COBC, which links object files into executables
#
# We are also going to maintain a copy of the original command sequence. We
# will be running that separately just be sure that if the user wants something
# I have been unable to anticipate, that it gets done properly.

ORIGINAL=""
SOURCEFILE=""
BASENAME=""
TARGET=""
PREOPTIONS=""
POSTOPTIONS=""
ORIGINALRUN="no"

#
# Because we need to have control over the intermediate files, and because
# the -save-temps switch works by creating the intermediate files locally and
# then moving them, and because the -g switch prevents the -save-temps switch
# from working properly, we have a problem.  For our purposes, all of those
# things are bad things.  We don't know exactly what the user might have in
# mind, and all of that creating and moving can result in our tripping on
# ourselves.  For example, I ran into trouble when one of the COBOL85 test
# programs provided by GnuCOBOL added a '-t something.lst' switch, which
# produced a compile error because I also have a '-T switch'.
#
# I tried creating a temporary directory and compiling from there, but ran
# into a NIST test case that had a COPY SOMEBOOK IN ../ELSEWHERE.  So, instead
# of that, I am now copying SOURCE.CBL into SOURCE-=-$PID.CBL.  Even though
# the intermediate files get created in the current directory, I have control
# over them and (unless I get lottery-winning unlucky) they won't interfere
# with anything else the user has in mind.
#

JUSTPUSH="no"
while (( $# )) ; do
  # Append the unaltered parameter to the list of original parameters.
  ORIGINAL="$ORIGINAL $1"

  PARM=$1  ## Our version of the parameter; we might modify it
  FIRSTCHAR="${PARM:0:1}"
  FIRSTTHREE="${PARM:0:3}"

  if test X$FIRSTCHAR != X"-" ; then
    # The first character is not a '-', so this is not a switch.

    # In the case where the filename is part of an double-entry switch (e.g.,
    # "-L <directory>" we will have set JUSTPUSH to "yes"

    if test X$JUSTPUSH = X"yes" ; then
      JUSTPUSH="no"
      # Put the parameter into the right list:
      if test X$SOURCEFILE = X"" ; then
        PREOPTIONS="$PREOPTIONS $PARM"
      else
        POSTOPTIONS="$POSTOPTIONS $PARM"
        fi
    else
      # If you get here, then you have a file name, and it wasn't preceded by
      # any switch explaining what to do with it.  So, in our simple universe
      # of an executable built from a single source modules) it must be the
      # the primary source code module:
      SOURCEFILE=$PARM

      # Extract any extension
      EXT="${1##*.}"

      # Extract the basename
      BASENAME=`basename $PARM .$EXT`

      fi
  else
    # The first character is a '-', so this is a switch
    if test X$PARM = X"-o" ; then
      # This is a -o switch.
      # Save the parameter as our ultimate target
      shift
      TARGET=$PARM
    elif test X$FIRSTTHREE = X"-t=" || test X$FIRSTTHREE = X"-T=" ; then
      # We know a -t=this or -T=that switch will break our compilation, so just ignore it
      ORIGINALRUN="yes"
    elif test X$PARM = X"-t" || test X$PARM = X"-T" ; then
      # We know a -t <file> or -T <file> switch will break our compilation, so
      # ignore the switch and the following parameter
      ORIGINALRUN="yes"
      shift
    elif test X$PARM = X"-x" || test X$PARM = X"-m" ; then
      # A command-line parameter overwhelms anything
      # we inherited
      COBCDXM=$PARM
    elif test X$PARM = X"-I" || test X$PARM = X"-L" || test X$PARM = X"-l" || \
         test X$PARM = X"-D" || test X$PARM = X"-A" || test X$PARM = X"-Q" || \
         test X$PARM = X"-K" || test X$PARM = X"-ext"; then
      # We need this switch...
      if test X$SOURCEFILE = X"" ; then
        PREOPTIONS="$PREOPTIONS $PARM"
      else
        POSTOPTIONS="$POSTOPTIONS $PARM"
        fi
      # ...and the parameter that follows
      JUSTPUSH="yes"
    else
      # Otherwise, add to PRE or POST options
      if test X$SOURCEFILE = X"" ; then
        PREOPTIONS="$PREOPTIONS $PARM"
      else
        POSTOPTIONS="$POSTOPTIONS $PARM"
        fi
      fi
    fi
  shift
  done

if test X$COBCDXM = X"" ; then
  # If neither -x nor -m was specified, explicitly match the COBC default of -m
  COBCDXM=-m
  fi

# For our purposes, we need to strike any leading path from the BASENAME:
BASENAME="${BASENAME##/*}"

# If there is no specific target, create one based on the source file name;
# it'll be put in the current working directory
if test X$TARGET = X"" ; then
  TARGET=$BASENAME
  if test X$COBCDXM = X"-m" ; then
    TARGET=$TARGET.so
    fi
  fi

TEMPEST="xXx12345"
TRUEBASENAME=$BASENAME
TRUESOURCEFILE=$SOURCEFILE
SOURCEFILE=$(echo $SOURCEFILE | sed "s/$TRUEBASENAME/$TRUEBASENAME$TEMPEST/")
BASENAME=$(echo $BASENAME | sed "s/$TRUEBASENAME/$TRUEBASENAME$TEMPEST/")
cp $TRUESOURCEFILE $SOURCEFILE

if test X$ECHO != X"" ; then
  echo GCC          $GCC
  echo CC1          $CC1
  echo ASSEMBLER    $ASSEMBLER
  echo LOADER       $LOADER
  echo COBC         $COBC
  echo COBST        $COBST
  echo SFIX         $SFIX
  echo COBCDEVEL    $COBCDEVEL
  echo COBCDNOCLEAN $COBCDNOCLEAN
  echo COBCDXM      $COBCDXM
  echo ORIGINAL     $ORIGINAL
  echo PREOPTIONS   $PREOPTIONS
  echo TRUESOURCEFILE $TRUESOURCEFILE
  echo TRUEBASENAME $TRUEBASENAME
  echo SOURCEFILE   $SOURCEFILE
  echo BASENAME     $BASENAME
  echo POSTOPTIONS  $POSTOPTIONS
  echo TARGET       $TARGET
  set | grep COB
  fi

#
# First, we sometimes execute the original command, unaltered. The need for this
# became clear when replaced the 'cobc' command in the GnuCOBOL 'make tests'
# chain and saw a number of errors in the COBOL85 test suite.  The generated
# code was okay, but there were some tests of the compiler being done as well,
# and it's easier to just run the original command than it is to parse
# everything out and try to duplicate it:
if test X$ORIGINALRUN = X"yes" ; then
  if test X$ECHO != X"" ; then
    echo $COBC $COBCDFLAGS $ORIGINAL
    fi
  $COBC $COBCDFLAGS $ORIGINAL
  fi

if test X$? = X"0" ; then
  if test X$BASENAME = X"" ; then
      echo "There doesn't seem to be a source file specified."
      echo "We can't proceed the the debug-capable build."
      exit 1
      fi
  fi

if test X$? = X"0" ; then
  #
  # So, at this point, any ancillary stuff that the user expected is in place.
  #
  # What we do now is switch to our temporary directory, and we do our compilation
  # there.

  # This first step builds the intermediate files that COBST needs.  Those files
  # include the .h files, the mixed-language
  if test X$ECHO != X"" ; then
    echo COB_CFLAGS="-Wa,-L,-anchls=$BASENAME.lst" $COBC $COBCDFLAGS -c $COBCDXM -d -g \
    --fgen-c-line-directives --fgen-c-labels \
    -T $BASENAME.cbl.lst --tlines=0 --tsymbols $PREOPTIONS $SOURCEFILE
    fi
  COB_CFLAGS="-Wa,-L,-anchls=$BASENAME.lst" $COBC $COBCDFLAGS -c $COBCDXM -d -g \
    --fgen-c-line-directives --fgen-c-labels \
    -T $BASENAME.cbl.lst --tlines=0 --tsymbols $PREOPTIONS $SOURCEFILE

  if test X$? = X"0" ; then
    ## Build the BASENAME.sym.c file
    if test X$ECHO != X"" ; then
      echo $COBST -q $BASENAME
      fi
    $COBST -q $BASENAME
    fi
  fi

if test X$? = X"0" ; then
  # Compile the .sym.c file, creating a .sym.o file containing the
  # .debug_gdb_scripts section with the VARIABLE_STRING and cprint.py script
  $GCC -c -o $BASENAME.sym.o $BASENAME.sym.c

  # Create the .s file from the .c file
  if test X$platform = Xx86_64 ; then
    if test X$ECHO != X"" ; then
      echo   $CC1 -quiet -imultiarch x86_64-linux-gnu \
        -D PIC $BASENAME.c -quiet -mtune=generic -march=x86-64 -g -fPIC \
        -fstack-protector-strong -Wformat -Wformat-security -o $BASENAME.s
      fi
    $CC1 -quiet -imultiarch x86_64-linux-gnu \
      -D PIC $BASENAME.c -quiet -mtune=generic -march=x86-64 -g -fPIC \
      -fstack-protector-strong -Wformat -Wformat-security -o $BASENAME.s
    fi
  fi

if test X$? = X"0" ; then
  if test X$platform = Xarm ; then
    # This worked on a Raspberry Pi 3 running buster
    $CC1 -quiet -imultilib . -imultiarch arm-linux-gnueabihf \
      $BASENAME.c -quiet -mfloat-abi=hard -mfpu=vfp -mtls-dialect=gnu \
      -marm -march=armv6+fp -g -fPIC -o $BASENAME.s
    fi
  fi

if test X$? = X"0" ; then
  # Modify the .s file, removing all .loc references to
  # BASENAME.c and any .h files.
  if test X$ECHO != X"" ; then
    echo $SFIX -q $BASENAME.s $BASENAME-2.s $BASENAME.c $SOURCEFILE
    fi
  $SFIX -q $BASENAME.s $BASENAME-2.s $BASENAME.c $SOURCEFILE
  fi

if test X$? = X"0" ; then
  # Assemble the modified .s file into a replacement .o file:
  if test X$platform = Xx86_64 ; then
    $ASSEMBLER --64 -L -anchls=$BASENAME-2.lst \
      -o $BASENAME-2.o $BASENAME-2.s
    fi
  fi

if test X$? = X"0" ; then
  if test X$platform = Xarm ; then
    # This worked on a Raspberry Pi 3 running buster
    $ASSEMBLER -march=armv6 -mfloat-abi=hard -mfpu=vfp -meabi=5 \
      -o $BASENAME-2.o $BASENAME-2.s
    fi
  fi

if test X$? = X"0" ; then
  # Combine the two .o files to create the executable
  # Stay in the original directory so that $TARGET, if relative, ends up in
  # the right place.

  if test X$COBCDXM = X"-x" ; then
    if test X$ECHO != X"" ; then
      echo $COBC $COBCDXM -o $TARGET $BASENAME-2.o $BASENAME.sym.o $POSTOPTIONS
      fi
    $COBC $COBCDXM -o $TARGET $BASENAME-2.o $BASENAME.sym.o $POSTOPTIONS
  else
    if test X$ECHO != X"" ; then
      echo $GCC -shared -o $TARGET $BASENAME-2.o $BASENAME.sym.o -lcob $POSTOPTIONS
      fi
    $GCC -shared -o $TARGET $BASENAME-2.o $BASENAME.sym.o -lcob $POSTOPTIONS
    fi
  fi

rm $SOURCEFILE

if test X$COBCDNOCLEAN != X"" ; then
  # We are going to keep the intermediate files; give them the right names
  files=`find . -maxdepth 1 -name "$TRUEBASENAME*"`
  for file in $files ; do
    newname=$(echo $file | sed "s/$TRUEBASENAME$TEMPEST/$TRUEBASENAME/")
    if test X$file != X$newname ; then
      mv $file $newname
      fi
    done
else
  # They want to delete the intermediate files...
  files=`find . -maxdepth 1 -name "$TRUEBASENAME$TEMPEST*"`
  for file in $files ; do
    rm $file
    done
  fi
