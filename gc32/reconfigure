#pacman --noconfirm -S mingw-w64-i686-libxml2
#pacman --noconfirm -S mingw-w64-i686-ncurses
#pacman --noconfirm -S vim

pacman --noconfirm -S mingw-w64-i686-gcc
## libintl-8
pacman --noconfirm -S libintl
