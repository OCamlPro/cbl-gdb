#!/bin/sh

##
## We want to clean up files when running on Linux, but not when
## we are running on Windows.
##
## We do this so that the MSYS2 packaging process doesn't clean up
## and delete the package it just built before it can be used.
##
## We need it to work on the Linux side so that when we create the
## clbgdb package we don't tarbell up the big Windows packages.
##

if ! uname | grep -q -e "^MSYS" ; then
  rm -fr gnucobl
  rm -fr pkg
  rm -fr src
  rm -fr *.log
  rm -fr *.zst
  fi
