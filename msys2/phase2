#!/bin/sh

## This routine expects to be running in a folder named
##
## ~/builds/cblgdb/cblgdb-latest/msys2
##
## It also expects to be running in a brand-spanking new instance of
## c:\msys64, one that has been updated with 
## 
##      pacman -Syu pacman
##      pacman -Su
##
## and with nothing else, in order to keep the size down as much as
## possible.
##
## It's to be run after ./phase1 has executed, and immediately after
## that environment was renamed to c:\msys64-build
##
## We first install the GnuCOBOL i686 package here, and we tack on
## gdb.
##
## We then create a target folder c:\cblgdb and we copy a subset of
## files from here to there.
##
## Install the GnuCOBOL i686 package from the place where we just build it
##
pacman --noconfirm -U $(ls -t --color=never \
    ~/builds/cblgdb/cblgdb-latest/msys2/mingw-w64-i686-gnucobol*.zst | head -n 1)
##
## We are going to create a "just-GnuCOBOL" minimal package from the
## the files we started with, plus the gnucobol package we just installed:
target=/c/gnucobol
##
rm -fr $target
mkdir -p $target/share/gnucobol/
mkdir -p $target/lib/
cp -r /mingw32/bin/                                                $target/bin/
cp -r /mingw32/i686-w64-mingw32/                                   $target/i686-w64-mingw32/
cp -r /mingw32/share/gnucobol/config/                              $target/share/gnucobol/config/
cp -r /mingw32/share/gnucobol/copy/                                $target/share/gnucobol/copy/
cp    /mingw32/lib/*                                               $target/lib/ 2>/dev/nul
cp -r /mingw32/lib/gcc/                                            $target/lib/gcc/
cp -r /mingw32/include/                                            $target/include/
cp -r ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/extras/     $target/extras/
cp -r /mingw32/lib/python3.8/                                      $target/lib/python3.8/
rm $target/include/autosp* 
mkdir -p $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/AUTHORS        $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/ChangeLog      $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/COPYING        $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/COPYING.DOC    $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/COPYING.LESSER $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/README         $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/THANKS         $target/license/
cp README-gnucobol.txt                                             $target/README.txt
##
##
## We are now going to add what we need to create a GnuCOBOL plus 
## the Symas/Camelian debugging extensions.
##
## That means we need the i686 gdb package:
##
pacman --noconfirm -S mingw-w64-i686-gdb
##
## Copy over the cbl-gdb executables and scripts from the place where
## we built them:
##
cp /c/msys64-build/usr/local/bin/cobcd     /mingw32/bin
cp /c/msys64-build/usr/local/bin/cobcd.bat /mingw32/bin
cp /c/msys64-build/usr/local/bin/cobst.exe /mingw32/bin
cp /c/msys64-build/usr/local/bin/cprint.py /mingw32/bin
cp /c/msys64-build/usr/local/bin/sfix.exe  /mingw32/bin
##
## This c:\msys64 now has everything it needs to run debuggable
## GnuCOBOL.
##
## It's time to spawn c:\cblgdb from us:
##
target=/c/cblgdb
rm -fr $target
mkdir -p $target/share/gnucobol/
mkdir -p $target/lib/
cp -r /mingw32/bin/                                                $target/bin/
cp -r /mingw32/i686-w64-mingw32/                                   $target/i686-w64-mingw32/
cp -r /mingw32/share/gdb/                                          $target/share/gdb/
cp -r /mingw32/share/gnucobol/config/                              $target/share/gnucobol/config/
cp -r /mingw32/share/gnucobol/copy/                                $target/share/gnucobol/copy/
cp    /mingw32/lib/*                                               $target/lib/ 2>/dev/nul
cp -r /mingw32/lib/gcc/                                            $target/lib/gcc/
cp -r /mingw32/include/                                            $target/include/
cp -r ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/extras/     $target/extras/
cp -r /mingw32/lib/python3.8/                                      $target/lib/python3.8/
rm $target/include/autosp*  
mkdir -p $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/AUTHORS        $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/ChangeLog      $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/COPYING        $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/COPYING.DOC    $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/COPYING.LESSER $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/README         $target/license/
cp ~/builds/cblgdb/cblgdb-latest/msys2/src/gnucobol/THANKS         $target/license/
cp README-cblgdb.txt                                               $target/README.txt



